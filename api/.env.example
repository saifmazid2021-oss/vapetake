# Local dev (matches database/docker-compose.yml):
VAPOSPY_PG_HOST=localhost
VAPOSPY_PG_PORT=5433
VAPOSPY_PG_DB=vapospy_clone
VAPOSPY_PG_USER=vapospy
VAPOSPY_PG_PASSWORD=vapospy

# Hosted (Railway/Render/etc.) -- if set, this takes priority over the vars above:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
